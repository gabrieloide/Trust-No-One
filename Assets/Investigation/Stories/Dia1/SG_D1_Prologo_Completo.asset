        waitForCompletion: 1
    - rid: 7508757932014830069
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName:
        dialogueText: "Near the curb by the gas station, a disheveled man sits
          on the concrete, clutching an Old Crow gin bottle in a paper bag."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830070
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Mark
        dialogueText: "Got a dollar, stranger?... Or a smoke. Doesn't matter. Nobody
          sleeps sound in this motel anyway."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830071
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "I leave him to his bottle and push through the front door
          into the motel lobby."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830072
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Elena
        dialogueText: "How many nights?"
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830073
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "One, hopefully. Just waiting on a tow truck."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830074
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_elena_talked
        amount: 1
    - rid: 7508757932014830075
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName:
        dialogueText: "A middle-aged man steps out from the hallway, impeccably
          dressed, with a wide smile that contrasts with the receptionist."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830076
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Welcome, welcome! Not every day someone's car breaks down
          right in front of our motel. Lucky, in the strangest possible way."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830077
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "I just need to get through the night until the tow truck
          gets here tomorrow."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830078
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Of course. I'll put you in room 4, the quietest one we have.
          If you need anything at all, any hour, don't hesitate to knock on my door."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830079
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName:
        dialogueText: "Everything about him is courtesy, calculated down to the
          millimeter. The kind of host you remember for how perfect he was, not
          how warm."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830080
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_robert_talked
        amount: 1
    - rid: 7508757932014830081
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "I step into room 4 and shut the door. I collapse on the bed
          to wait out the night."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830082
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 0
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.6
        curve:
          serializedVersion: 2
          m_Curve:
          - serializedVersion: 3
            time: 0
            value: 0
            inSlope: 0
            outSlope: 0
            tangentMode: 0
            weightedMode: 0
            inWeight: 0
            outWeight: 0
