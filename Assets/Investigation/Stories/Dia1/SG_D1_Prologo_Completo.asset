    - rid: 7508757932014829929
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "El auto se apaga a diez minutos de cualquier cosa. El \xFAnico
          cartel en kil\xF3metros dice MOTEL, con una flecha pintada a mano."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829930
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "No va a venir ninguna gr\xFAa antes de ma\xF1ana. Voy a tener
          que quedarme."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829931
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "A unos metros, un hombre carga cajas hacia una camioneta.
          Se frena en seco al verme, como si hubiera memorizado cada cara del pueblo
          y la m\xEDa no encajara."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829932
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Ernesto
        dialogueText: "\xBFUsted es nuevo por ac\xE1? No... no suelo ver caras nuevas
          seguido."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829933
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Se me rompi\xF3 el auto en la ruta. Voy a quedarme una noche
          en el motel."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829934
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Ernesto
        dialogueText: El motel. Claro. Buena suerte con eso.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829935
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Lo dice como quien repite un chiste privado que no piensa explicar.
          Sigue cargando cajas sin volver a mirarme.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829936
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_ernesto_talked
        amount: 1
    - rid: 7508757932014829937
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 0
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.4
        curve:
          serializedVersion: 2
          m_Curve:
