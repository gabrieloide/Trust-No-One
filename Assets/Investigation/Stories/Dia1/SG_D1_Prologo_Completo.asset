      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "The next morning, Frank tells me from the gas station that
          the part for my car will take two days to arrive from the city."
        characterPortrait: {fileID: 0}
