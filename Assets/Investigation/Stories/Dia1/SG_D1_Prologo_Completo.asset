    - rid: 7508757932014830067
      type: {class: TravelLocationAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        targetLocationId: motel
    - rid: 7508757932014830068
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 1
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.4
        curve:
          serializedVersion: 2
          m_Curve:
