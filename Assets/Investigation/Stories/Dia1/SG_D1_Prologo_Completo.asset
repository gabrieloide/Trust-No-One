    - rid: 7508757932014829882
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Camino hasta la recepci\xF3n del motel. Una mujer joven atiende
          el mostrador sin levantar mucho la vista."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829883
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Elena
        dialogueText: "\xBFCu\xE1ntas noches?"
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829884
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: Una, con suerte.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829885
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Elena
        dialogueText: "Ac\xE1 nadie se queda una sola noche por suerte."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829886
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Me entrega una llave de bronce y vuelve a sus papeles antes
          de que pueda agregar una sola palabra.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829887
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_elena_talked
        amount: 1
    - rid: 7508757932014829888
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Desde el pasillo sale un hombre de mediana edad, impecable
          y con una sonrisa amplia que contrasta con la recepcionista.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829889
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "\xA1Bienvenido, bienvenido! No todos los d\xEDas se le rompe
          el auto a alguien justo frente a nuestro motel. Tiene suerte, en el sentido
          m\xE1s raro posible."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829890
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Solo necesito pasar la noche hasta que llegue el auxilio ma\xF1ana."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829891
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Por supuesto. Le toca la habitaci\xF3n 4, es la m\xE1s tranquila
          de todas. Si necesita cualquier cosa, a cualquier hora, golpee mi puerta
          sin dudar."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829892
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Todo en \xE9l es cortes\xEDa calculada al mil\xEDmetro. El
          tipo de anfitri\xF3n que uno recuerda por lo perfecto, no por lo c\xE1lido."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829893
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_robert_talked
        amount: 1
    - rid: 7508757932014829894
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Entro a la habitaci\xF3n 4 y cierro la puerta. Me tiro sobre
          la cama a esperar que pase la noche."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829895
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 0
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.8
        curve:
          serializedVersion: 2
          m_Curve:
          - serializedVersion: 3
            time: 0
            value: 0
            inSlope: 0
            outSlope: 0
