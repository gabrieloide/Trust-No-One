    - rid: 7508757932014830096
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Le sugiero volver a su habitaci\xF3n y cerrar con llave. Esto
          no es algo que un hu\xE9sped deba presenciar."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
