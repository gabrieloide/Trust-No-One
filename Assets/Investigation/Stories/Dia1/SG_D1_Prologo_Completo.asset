        targetLocationId: road
    - rid: 7508757932014829734
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: "D\xCDA 1"
        subtitleText: "La carretera de ning\xFAn lugar"
        displayMode: 0
        effect: 0
        duration: 2
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014829735
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "El auto se apaga a diez minutos de cualquier cosa. El \xFAnico
          cartel en kil\xF3metros dice MOTEL, con una flecha pintada a mano."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829736
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "No va a venir ninguna gr\xFAa antes de ma\xF1ana. Voy a tener
          que quedarme."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829737
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "A unos metros, un hombre carga cajas hacia una camioneta.
          Se frena en seco al verme, como si hubiera memorizado cada cara del pueblo
          y la m\xEDa no encajara."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829738
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Ernesto
        dialogueText: "\xBFUsted es nuevo por ac\xE1? No... no suelo ver caras nuevas
          seguido."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829739
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Se me rompi\xF3 el auto en la ruta. Voy a quedarme una noche
          en el motel."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829740
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Ernesto
        dialogueText: El motel. Claro. Buena suerte con eso.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829741
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Lo dice como quien repite un chiste privado que no piensa explicar.
          Sigue cargando cajas sin volver a mirarme.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829742
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_ernesto_talked
        amount: 1
    - rid: 7508757932014829743
      type: {class: TravelLocationAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        targetLocationId: motel
    - rid: 7508757932014829744
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Camino hasta la recepci\xF3n del motel. Una mujer joven atiende
          el mostrador sin levantar mucho la vista."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829745
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Elena
        dialogueText: "\xBFCu\xE1ntas noches?"
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829746
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: Una, con suerte.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829747
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Elena
        dialogueText: "Ac\xE1 nadie se queda una sola noche por suerte."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829748
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Me entrega una llave de bronce y vuelve a sus papeles antes
          de que pueda agregar una sola palabra.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829749
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_elena_talked
        amount: 1
    - rid: 7508757932014829750
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Desde el pasillo sale un hombre de mediana edad, impecable
          y con una sonrisa amplia que contrasta con la recepcionista.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829751
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "\xA1Bienvenido, bienvenido! No todos los d\xEDas se le rompe
          el auto a alguien justo frente a nuestro motel. Tiene suerte, en el sentido
          m\xE1s raro posible."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829752
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Solo necesito pasar la noche hasta que llegue el auxilio ma\xF1ana."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829753
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Por supuesto. Le toca la habitaci\xF3n 4, es la m\xE1s tranquila
          de todas. Si necesita cualquier cosa, a cualquier hora, golpee mi puerta
          sin dudar."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829754
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Todo en \xE9l es cortes\xEDa calculada al mil\xEDmetro. El
          tipo de anfitri\xF3n que uno recuerda por lo perfecto, no por lo c\xE1lido."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829755
      type: {class: CaseFlagAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        operation: 0
        key: d1_robert_talked
        amount: 1
    - rid: 7508757932014829756
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: 
        subtitleText: Esa noche...
        displayMode: 1
        effect: 0
        duration: 2
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014829757
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Un grito corto, cortado a la mitad. Despu\xE9s, el sonido
          seco de vidrio rompi\xE9ndose contra el suelo."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829758
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Salgo al pasillo alertado por el estruendo. Apenas alcanzo
          a ver la silueta de Elena corriendo despavorida hacia la salida trasera.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829759
      type: {class: CollectClueAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        clueId: elena_seen_running
    - rid: 7508757932014829760
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Sigo el ruido hasta la parte trasera del motel, cerca del
          acceso al s\xF3tano. Hay una mujer inm\xF3vil en el suelo, rodeada de vidrios
          rotos."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829761
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "En cuesti\xF3n de segundos aparece Robert, perfectamente peinado
          y vestido, como si nunca se hubiera acostado."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829762
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "\xBFQu\xE9 fue ese grito? \xBFQui\xE9n es la mujer del suelo?"
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829763
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Es Carla... Carla Rossi. Pobrecita, Dios m\xEDo... parece
          que tropez\xF3 con una botella o alguien la atac\xF3 en la oscuridad."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829764
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "\xBFLleg\xF3 usted muy r\xE1pido, no? Apenas se escuch\xF3
          el golpe."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829765
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Tengo el sue\xF1o ligero cuando se trata de la seguridad de
          mi motel, se\xF1or Miller. Ya avis\xE9 al sheriff del condado, estar\xE1n
          aqu\xED a primera hora."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829766
      type: {class: CollectClueAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        clueId: robert_quick_arrival
    - rid: 7508757932014829767
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Le sugiero volver a su habitaci\xF3n y cerrar con llave. Esto
          no es algo que un hu\xE9sped deba presenciar."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829768
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: 
        subtitleText: "Fin del D\xEDa 1"
        displayMode: 2
        effect: 0
        duration: 2
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014829769
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: "D\xCDA 2"
        subtitleText: La lista de sospechosos no incluye a Robert Hale
        displayMode: 0
        effect: 0
        duration: 2.5
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014829770
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "A la ma\xF1ana siguiente, la polic\xEDa local anota cuatro
          datos con desgano. Tienen tres sospechosos f\xE1ciles: el borracho de la
          gasolinera, el comerciante nuevo y la chica de recepci\xF3n."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829771
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Pero nadie mira a Robert Hale. El due\xF1o del motel parece
          intocable para todos en este pueblo... y eso es exactamente lo que me huele
          mal."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829772
      type: {class: SetDayPhaseAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        targetDay: 2
        targetPhase: 1
        actionsRemaining: 4
    - rid: 7508757932014829773
      type: {class: SetWorldUIAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        active: 1
    - rid: 7508757932014829774
      type: {class: TravelLocationAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        targetLocationId: motel
