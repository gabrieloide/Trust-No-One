    - rid: 7508757932014830083
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: 
        subtitleText: Esa misma noche... 02:15 AM
        displayMode: 0
        effect: 0
        duration: 2
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014830084
      type: {class: TravelLocationAction, ns: Investigation, asm: Investigation.Runtime}
