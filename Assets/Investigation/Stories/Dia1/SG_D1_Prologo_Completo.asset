        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014830057
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 1
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.6
        curve:
          serializedVersion: 2
          m_Curve:
          - serializedVersion: 3
            time: 0
            value: 0
            inSlope: 0
            outSlope: 0
