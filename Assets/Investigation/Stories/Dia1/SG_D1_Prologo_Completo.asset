    - rid: 7508757932014829974
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "A la ma\xF1ana siguiente, Frank me avisa desde la gasolinera
          que el repuesto de mi auto tardar\xE1 dos d\xEDas en llegar desde la ciudad."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829975
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "Tras el crimen de Carla Rossi, Robert me ofreci\xF3 extender
          mi estad\xEDa en la habitaci\xF3n 4 sin cargo mientras colabore como testigo.
          Tengo dos d\xEDas antes de que llegue la gr\xFAa y el sheriff cierre el
          caso."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014829976
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
