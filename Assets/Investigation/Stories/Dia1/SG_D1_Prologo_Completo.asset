            time: 1
            value: 1
            inSlope: 0
            outSlope: 0
            tangentMode: 0
            weightedMode: 0
            inWeight: 0
            outWeight: 0
          m_PreInfinity: 2
          m_PostInfinity: 2
          m_RotationOrder: 4
        waitForCompletion: 1
    - rid: 7508757932014830014
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: 
        subtitleText: Esa misma noche... 02:15 AM
        displayMode: 0
        effect: 0
        duration: 2
        waitForClick: 1
        fadeDuration: 0.5
    - rid: 7508757932014830015
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Un grito desgarrador corta la madrugada. Despu\xE9s, el sonido
          seco de vidrio rompi\xE9ndose contra el suelo."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830016
      type: {class: FadeScreenAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        fadeType: 1
        fadeColor: {r: 0, g: 0, b: 0, a: 1}
        duration: 0.5
        curve:
          serializedVersion: 2
          m_Curve:
          - serializedVersion: 3
            time: 0
            value: 0
            inSlope: 0
            outSlope: 0
            tangentMode: 0
            weightedMode: 0
            inWeight: 0
            outWeight: 0
          - serializedVersion: 3
            time: 1
            value: 1
            inSlope: 0
            outSlope: 0
            tangentMode: 0
            weightedMode: 0
            inWeight: 0
            outWeight: 0
          m_PreInfinity: 2
          m_PostInfinity: 2
          m_RotationOrder: 4
        waitForCompletion: 1
    - rid: 7508757932014830017
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: Salgo al pasillo alertado por el estruendo. Apenas alcanzo
          a ver la silueta de Elena corriendo despavorida hacia la salida trasera.
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830018
      type: {class: CollectClueAction, ns: Investigation, asm: Investigation.Runtime}
      data:
        enabled: 1
        clueId: elena_seen_running
    - rid: 7508757932014830019
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "Sigo el ruido hasta la parte trasera del motel, cerca del
          acceso al s\xF3tano. Hay una mujer inm\xF3vil en el suelo, rodeada de vidrios
          rotos."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830020
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: 
        dialogueText: "En cuesti\xF3n de segundos aparece Robert, perfectamente peinado
          y vestido, como si nunca se hubiera acostado."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830021
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "\xBFQu\xE9 fue ese grito? \xBFQui\xE9n es la mujer del suelo?"
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830022
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Es Carla... Carla Rossi. Pobrecita, Dios m\xEDo... parece
          que tropez\xF3 con una botella o alguien la atac\xF3 en la oscuridad."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830023
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Gabe
        dialogueText: "\xBFLleg\xF3 usted muy r\xE1pido, no? Apenas se escuch\xF3
          el golpe."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
        waitForClick: 1
        hideAfterFinished: 0
    - rid: 7508757932014830024
      type: {class: DialogueAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        speakerName: Robert
        dialogueText: "Tengo el sue\xF1o ligero cuando se trata de la seguridad de
          mi motel, se\xF1or Miller. Ya avis\xE9 al sheriff del condado, estar\xE1n
          aqu\xED a primera hora."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
