    - rid: 7508757932014830056
      type: {class: OverlayTextAction, ns: VisualNovelSystem, asm: VisualNovelSystem.Runtime}
      data:
        enabled: 1
        titleText: NO ONE IS INNOCENT
        subtitleText: "Day 1 — The road to nowhere"
        displayMode: 0
