      data:
        enabled: 1
        speakerName: 
        dialogueText: "Un grito corto, cortado a la mitad. Despu\xE9s, vidrio rompi\xE9ndose."
        characterPortrait: {fileID: 0}
        voiceClip: {fileID: 0}
        typewriterSpeed: 0.03
