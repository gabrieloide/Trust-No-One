{
    "id": "mark",
    "displayName": "Mark Doss",
    "portraitId": "mark_default",
    "topics": [
        {
            "id": "mark_noises",
            "displayName": "Preguntarle qué vio o escuchó",
            "kind": 0,
            "unlockConditions": [
                { "kind": 0, "a": "d2p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Mark está sentado contra la pared de la gasolinera, temblando y hablando entre dientes." },
                        { "speaker": "Mark", "text": "Ruidos. Anoche, antes, siempre. Golpes abajo. Como que alguien golpea para que lo escuchen y nadie escucha." },
                        { "speaker": "Gabe", "text": "¿Golpes de dónde?" },
                        { "speaker": "Mark", "text": "Del motel. Debajo del motel. Ahí hay gente. Encerrada gente. Se lo dije a Frank una vez y se rió." },
                        { "speaker": "", "text": "Habla rápido, salta de una idea a otra, pero hay un patrón debajo de su delirio." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_noises_match", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "mark_noises_believe",
            "displayName": "Decirle que le cree",
            "kind": 1,
            "unlockConditions": [
                { "kind": 0, "a": "d2p2_started", "b": "", "negate": false },
                { "kind": 2, "a": "mark", "b": "mark_noises", "negate": false },
                { "kind": 2, "a": "mark", "b": "mark_noises_believe", "negate": true },
                { "kind": 2, "a": "mark", "b": "mark_noises_dismiss", "negate": true }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "Gabe", "text": "Le creo, Mark. Siga." },
                        { "speaker": "Mark", "text": "¿Sí? Nadie me cree nunca. Ni yo a veces." },
                        { "speaker": "", "text": "Se calma un poco, mirándome a los ojos." },
                        { "speaker": "Mark", "text": "Hale. Siempre Hale bajando de noche. Con una bolsa, con una caja. Nunca baja vacío." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "mark_trusted", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "mark_noises_dismiss",
            "displayName": "Cortarlo, no suena confiable",
            "kind": 1,
            "unlockConditions": [
                { "kind": 0, "a": "d2p2_started", "b": "", "negate": false },
                { "kind": 2, "a": "mark", "b": "mark_noises", "negate": false },
                { "kind": 2, "a": "mark", "b": "mark_noises_believe", "negate": true },
                { "kind": 2, "a": "mark", "b": "mark_noises_dismiss", "negate": true }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "Gabe", "text": "Ya entendí, Mark. Gracias." },
                        { "speaker": "", "text": "No le creo. Y se nota enseguida." },
                        { "speaker": "Mark", "text": "Claro. Como todos. El loco habla, el loco no importa." }
                    ],
                    "effects": [
                        { "kind": 4, "a": "mark_credibility_broken", "b": "1" }
                    ]
                }
            ]
        },
        {
            "id": "mark_more",
            "displayName": "Volver a preguntarle por esa noche",
            "kind": 0,
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "broken",
                    "priority": 1,
                    "conditions": [
                        { "kind": 5, "a": "mark_credibility_broken", "b": "1", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "Mark", "text": "Botellas vacías... todo se mezcla. El frío, el viento. No sé nada, no me acuerdo de nada." },
                        { "speaker": "Gabe", "text": "¿Y de los pasos que escuchaba antes?" },
                        { "speaker": "Mark", "text": "¿Qué pasos? Déjeme en paz. Ya me dijo que no me cree." },
                        { "speaker": "", "text": "Se da vuelta contra la pared. No hay forma de sacarle nada ahora." }
                    ],
                    "effects": []
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "Mark", "text": "Pasos. Casi todas las noches, pasos bajando." },
                        { "speaker": "Gabe", "text": "¿Y la noche que murió la chica?" },
                        { "speaker": "Mark", "text": "Esa... no. Esa noche se me borra. Como si alguien me la hubiera arrancado de la cabeza." },
                        { "speaker": "", "text": "Es la primera vez que lo veo admitir que no sabe algo, en vez de inventarlo." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "mark_no_memory", "b": "" }
                    ]
                }
            ]
        }
    ]
}
