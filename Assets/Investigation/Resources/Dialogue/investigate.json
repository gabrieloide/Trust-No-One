{
    "spots": [
        {
            "id": "inv_arbustos",
            "displayName": "Arbustos junto a la escena",
            "unlockConditions": [
                { "kind": 0, "a": "d2p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "lead_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "arbustos_lead_mentioned", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Sabiendo lo que me dijo Gus, me agacho a revisar el fango detrás del cerco de arbustos." },
                        { "speaker": "", "text": "Las ramas quebradas están a la altura de los hombros. Hay una pisada profunda en el barro: suela de cuero rígido, taco fino." },
                        { "speaker": "", "text": "No son las zapatillas deshechas de Mark. Quien escapó por acá llevaba zapatos de vestir." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" },
                        { "kind": 0, "a": "arbustos_formal_shoes_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Ramas rotas en la banquina, tierra removida. Alguien pasó por acá con apuro hacia la parte trasera del motel." },
                        { "speaker": "", "text": "No hay una huella clara sin saber qué buscar, pero confirma que hubo movimiento antes del amanecer." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_carpet_shop_receipt",
            "displayName": "Mostrador de la tienda de alfombras",
            "unlockConditions": [
                { "kind": 0, "a": "d2p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_ernesto_talk",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "ernesto_denied_unprompted", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Vuelvo a mirar los papeles en el mostrador tras la reacción nerviosa de Ernesto." },
                        { "speaker": "", "text": "No solo no vende alfombras: al dorso de un remito hay una anotación a mano con la caligrafía de Robert: 'Pago mensual postergado a cambio de fletes nocturnos'." },
                        { "speaker": "", "text": "Ernesto no solo está quebrado; está endeudado hasta el cuello con el dueño del motel." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" },
                        { "kind": 0, "a": "ernesto_debt_revealed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Un recibo arrugado sobre el mostrador, tirado como quien no espera que nadie lo lea." },
                        { "speaker": "", "text": "Tres ventas menores en dos meses. Un negocio comercial no se sostiene con estos números. ¿Qué más se paga acá?" }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_scene_glass",
            "displayName": "Perímetro de la escena",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_frank_lead",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "frank_saw_mark_and_carla", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Teniendo en mente el testimonio de Frank, examino los fragmentos bajo el farol." },
                        { "speaker": "", "text": "El gollete conserva parte de la etiqueta: 'Old Crow Gin'. Es exactamente la botella que Frank le vendió a Mark antes de la discusión." },
                        { "speaker": "", "text": "El impacto fue contra el cordón de la vereda, no contra el cuerpo de la víctima. La botella cayó durante un forcejeo." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" },
                        { "kind": 3, "a": "bottle_was_marks", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Vidrio verde, grueso. Los bordes coinciden con las botellas baratas que se consiguen en la gasolinera." },
                        { "speaker": "", "text": "Las mismas que suele cargar Mark. Eso sugiere su presencia, pero todavía no prueba agresión directa." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_basement_lock",
            "displayName": "Puerta del sótano",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "keys_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Elena me confirmó que solo Robert tiene la llave de esta puerta." },
                        { "speaker": "", "text": "Miro el cerrojo de cerca: los remaches saltaron hacia afuera por un golpe seco desde el interior de la habitación subterránea." },
                        { "speaker": "", "text": "Robert cerró con llave a alguien ahí abajo, y esa persona intentó escapar desesperadamente antes de morir." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" },
                        { "kind": 0, "a": "basement_forced_from_inside_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "La cadena cuelga suelta. El candado no está forzado desde afuera: está reventado desde adentro." },
                        { "speaker": "", "text": "Alguien quiso salir de ahí. No entrar." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_crime_scene_fiber",
            "displayName": "Revisión de la escena (Día 3)",
            "unlockConditions": [
                { "kind": 0, "a": "d3p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "receipt_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Con el catálogo de la tienda de Ernesto en mente, reviso las astillas del marco inferior." },
                        { "speaker": "", "text": "Una fibra verde oliva sintética. El hilado y el tinte coinciden exactamente con el rollo de fletes de Ernesto Vidal." },
                        { "speaker": "", "text": "El cuerpo fue transportado envuelto en un retazo de esa alfombra antes de ser depositado junto al sótano." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" },
                        { "kind": 0, "a": "carpet_body_wrap_deduced", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "En la segunda pasada uno ve lo que se le escapó en la primera." },
                        { "speaker": "", "text": "Una fibra verde oliva, enganchada en una astilla. No es de nada que haya en este motel." },
                        { "speaker": "", "text": "Alfombra sintética. Conozco un solo lugar en el pueblo que vende de esa." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_basement_revisit",
            "displayName": "Sótano, segunda revisión",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "combo",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_lock", "b": "", "negate": false },
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Candado reventado desde adentro. Una sola llave en todo el motel en manos de Robert Hale." },
                        { "speaker": "", "text": "Dos hechos sueltos que, juntos, destruyen cualquier intento de coartada accidental." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "basement_combo_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Vuelvo a mirar la puerta del sótano. Todavía me falta una pieza para que esto cierre de manera irrefutable." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_robert_office",
            "displayName": "Oficina de Robert",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Un cuaderno de mantenimiento sobre el escritorio. Entradas ordenadas y prolijas: 'revisión de válvulas', 'combustible para generador', 'compra de insumos'." },
                        { "speaker": "", "text": "Todo parece estar en regla. La bitácora detallada de un administrador meticuloso." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "maintenance_log_seen", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_near_basement_carla",
            "displayName": "Rincón junto al sótano",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "elena_trusted",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "elena_trust_intact", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Siguiendo las indicaciones entrecortadas que me dio Elena, busco detrás del apilamiento de cajones de madera." },
                        { "speaker": "", "text": "Un bolso de viaje femenino con las iniciales 'C.R.'. Adentro hay un pasaje de ómnibus a Seattle para esa misma madrugada." },
                        { "speaker": "", "text": "Carla no iba a quedarse en el motel. Iba a huir. Robert lo descubrió y no la dejó llegar a la parada." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" },
                        { "kind": 0, "a": "carla_escape_ticket_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Detrás de unas cajas de herramientas, escondidas más que guardadas: pertenencias que no son del motel." },
                        { "speaker": "", "text": "Ropa doblada con prisa, un cepillo, documentos personales de Carla Rossi." },
                        { "speaker": "", "text": "¿Quién las escondió acá en vez de dejarlas en su habitación? El asesino intentó borrar su paso por el Starlight." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" }
                    ]
                }
            ]
        }
    ]
}
