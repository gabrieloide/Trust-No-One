{
    "spots": [
        {
            "id": "inv_arbustos",
            "displayName": "Bushes near the crime scene",
            "unlockConditions": [
                { "kind": 0, "a": "d2p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "lead_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "arbustos_lead_mentioned", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Knowing what Gus told me, I crouch down to check the mud behind the hedge." },
                        { "speaker": "", "text": "The broken branches are at shoulder height. There's a deep print in the mud: stiff leather sole, thin heel." },
                        { "speaker": "", "text": "Those aren't Mark's worn-out sneakers. Whoever ran through here was wearing dress shoes." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" },
                        { "kind": 0, "a": "arbustos_formal_shoes_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Broken branches by the roadside, disturbed dirt. Someone came through here in a hurry, heading for the back of the motel." },
                        { "speaker": "", "text": "There's no clear print without knowing what to look for, but it confirms there was movement before dawn." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_carpet_shop_receipt",
            "displayName": "Carpet shop counter",
            "unlockConditions": [
                { "kind": 0, "a": "d2p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_ernesto_talk",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "ernesto_denied_unprompted", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "I take another look at the papers on the counter after Ernesto's nervous reaction." },
                        { "speaker": "", "text": "He's not just failing to sell carpet: on the back of an invoice there's a note in Robert's handwriting: 'Monthly payment deferred in exchange for night hauls.'" },
                        { "speaker": "", "text": "Ernesto isn't just broke; he's in deep with the motel owner." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" },
                        { "kind": 0, "a": "ernesto_debt_revealed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "A crumpled receipt on the counter, tossed aside like nobody was ever meant to read it." },
                        { "speaker": "", "text": "Three small sales in two months. A business can't survive on these numbers. What else is getting paid for here?" }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_scene_glass",
            "displayName": "Crime scene perimeter",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_frank_lead",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "frank_saw_mark_and_carla", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Keeping Frank's testimony in mind, I examine the fragments under the streetlamp." },
                        { "speaker": "", "text": "The neck still has part of the label: 'Old Crow Gin.' It's exactly the bottle Frank sold Mark before the argument." },
                        { "speaker": "", "text": "The impact was against the curb, not the victim's body. The bottle fell during a struggle." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" },
                        { "kind": 3, "a": "bottle_was_marks", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Thick green glass. The edges match the cheap bottles sold at the gas station." },
                        { "speaker": "", "text": "The same kind Mark usually carries. That suggests his presence, but it still doesn't prove direct assault." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_basement_lock",
            "displayName": "Basement door",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "keys_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Elena confirmed that only Robert has the key to this door." },
                        { "speaker": "", "text": "I look closely at the lock: the rivets popped outward from a hard blow from inside the underground room." },
                        { "speaker": "", "text": "Robert locked someone down there, and that person tried desperately to escape before dying." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" },
                        { "kind": 0, "a": "basement_forced_from_inside_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The chain hangs loose. The padlock isn't forced from outside: it's busted from the inside." },
                        { "speaker": "", "text": "Someone wanted out of there. Not in." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_crime_scene_fiber",
            "displayName": "Scene re-examination (Day 3)",
            "unlockConditions": [
                { "kind": 0, "a": "d3p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "receipt_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "With Ernesto's shop catalog in mind, I check the splinters on the lower frame." },
                        { "speaker": "", "text": "A synthetic olive-green fiber. The weave and the dye match exactly the roll from Ernesto Vidal's shop." },
                        { "speaker": "", "text": "The body was carried wrapped in a scrap of that carpet before being left by the basement." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" },
                        { "kind": 0, "a": "carpet_body_wrap_deduced", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "On the second pass, you see what you missed the first time." },
                        { "speaker": "", "text": "An olive-green fiber, snagged on a splinter. It's not from anything in this motel." },
                        { "speaker": "", "text": "Synthetic carpet. I know exactly one place in town that sells it." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_basement_revisit",
            "displayName": "Basement, second look",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "combo",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_lock", "b": "", "negate": false },
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Padlock busted from the inside. One single key in the whole motel, and it's in Robert Hale's hands." },
                        { "speaker": "", "text": "Two loose facts that, together, destroy any attempt at an innocent explanation." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "basement_combo_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "I take another look at the basement door. I still need one more piece to close this case for good." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_robert_office",
            "displayName": "Robert's office",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "A maintenance logbook on the desk. Neat, orderly entries: 'valve inspection,' 'generator fuel,' 'supply purchase.'" },
                        { "speaker": "", "text": "Everything looks in order. The detailed log of a meticulous manager." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "maintenance_log_seen", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_near_basement_carla",
            "displayName": "Corner by the basement",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "elena_trusted",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "elena_trust_intact", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Following the halting directions Elena gave me, I search behind the stack of wooden crates." },
                        { "speaker": "", "text": "A woman's travel bag with the initials 'C.R.' Inside is a bus ticket to Seattle for that very same dawn." },
                        { "speaker": "", "text": "Carla wasn't planning to stay at the motel. She was planning to run. Robert found out, and he never let her reach that bus stop." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" },
                        { "kind": 0, "a": "carla_escape_ticket_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Behind some toolboxes, hidden more than stored: belongings that don't belong to the motel." },
                        { "speaker": "", "text": "Hastily folded clothes, a hairbrush, Carla Rossi's personal documents." },
                        { "speaker": "", "text": "Who hid these here instead of leaving them in her room? The killer tried to erase her time at the Starlight." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" }
                    ]
                }
            ]
        }
    ]
}
