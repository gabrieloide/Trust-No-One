{
    "spots": [
        {
            "id": "inv_motel_lobby_morning",
            "displayName": "Motel lobby, morning after",
            "unlockConditions": [
                { "kind": 0, "a": "d2p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The lobby smells like burnt coffee and old cigarettes. The guest registry is open on the counter, only two names inked in for the whole week." },
                        { "speaker": "", "text": "A muddy footprint is drying near the door, already too smudged to mean anything." },
                        { "speaker": "", "text": "Someone mopped half the floor and gave up halfway through. This town cleans up fast when it wants to, and slow when it doesn't." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_arbustos",
            "displayName": "Bushes near the crime scene",
            "unlockConditions": [
                { "kind": 0, "a": "d2p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "lead_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "arbustos_lead_mentioned", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Knowing what Gus told me, I crouch down to check the mud behind the hedge." },
                        { "speaker": "", "text": "The broken branches are fresh. There's a clear print in the wet soil: stiff leather sole, thin heel." },
                        { "speaker": "", "text": "Those aren't Mark's worn sneakers or Ernesto's work boots. Whoever pursued Carla here was wearing formal dress shoes." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" },
                        { "kind": 0, "a": "arbustos_formal_shoes_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Broken branches by the roadside hedge, disturbed dirt. Someone ran through here in a hurry toward the dark alley." },
                        { "speaker": "", "text": "There's no clear print without knowing what to look for, but it confirms a struggle took place before dawn." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "arbustos_examined", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_carpet_shop_receipt",
            "displayName": "Carpet shop counter",
            "unlockConditions": [
                { "kind": 0, "a": "d2p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_ernesto_talk",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "ernesto_denied_unprompted", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "I take another look at the papers on the counter after Ernesto's nervous reaction." },
                        { "speaker": "", "text": "He's not just failing to sell carpets: on the back of an overdue bill, there's a note in Robert's handwriting: 'Monthly debt deferred in exchange for night transport and supply hauls.'" },
                        { "speaker": "", "text": "Ernesto isn't just broke; he's completely trapped by Robert Hale's financial leverage." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" },
                        { "kind": 0, "a": "ernesto_debt_revealed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "A crumpled invoice on the counter, tossed aside like nobody was ever meant to read it." },
                        { "speaker": "", "text": "Near-zero sales in three months. A business cannot survive on these numbers without hidden income." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_scene_glass",
            "displayName": "Crime scene perimeter",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "post_frank_lead",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "frank_saw_mark_and_carla", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Keeping Frank's testimony in mind, I examine the glass shards under the perimeter light." },
                        { "speaker": "", "text": "The neck still carries the label: 'Old Crow Gin.' It matches the exact bottle Mark purchased at the gas station." },
                        { "speaker": "", "text": "The bottle shattered against the curb when Mark stumbled. The killer snatched the jagged neck right from the ground to strike Carla." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" },
                        { "kind": 3, "a": "bottle_was_marks", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Thick green glass fragments scattered near the curb. The label indicates cheap gin." },
                        { "speaker": "", "text": "The same brand Mark usually carries. That confirms his presence, but the fatal attack happened seconds later in the bushes." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "glass_matches_bottle", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_road_shoulder_night",
            "displayName": "Road shoulder at night",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The highway shoulder is dead quiet, gravel crunching under my own footsteps like gunshots in the dark." },
                        { "speaker": "", "text": "Old glass shards from the gin bottle are still scattered near the curb, catching what little light the motel sign throws this far." },
                        { "speaker": "", "text": "Nothing new here. Just the same night, replaying itself for anyone patient enough to stand in it." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_motel_backdoor_tracks",
            "displayName": "Motel back door, after dark",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "I crouch by the back door with my flashlight low, out of sight of the office window." },
                        { "speaker": "", "text": "Faint tire tread marks cut through the gravel, wide grooves, work tires. Not a sedan. Something closer to a pickup." },
                        { "speaker": "", "text": "Nobody mentioned a truck parked back here last night. Somebody should have." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "pickup_tread_marks", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_basement_lock",
            "displayName": "Basement door",
            "unlockConditions": [
                { "kind": 0, "a": "d2p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "keys_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Elena confirmed that only Robert has the key to this boiler room door." },
                        { "speaker": "", "text": "I inspect the chain and latch closely: a heavy boiler wrench was jammed through the door gap from the inside, bending the rusted eyelet outward with brutal leverage." },
                        { "speaker": "", "text": "Robert locked Carla inside the basement, and she broke her way out into the dark to catch the morning bus." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" },
                        { "kind": 0, "a": "basement_forced_from_inside_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The chain hangs loose against the wooden frame. The padlock and latch were pried open from the inside." },
                        { "speaker": "", "text": "Someone trapped down in the boiler room fought desperately to break out." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "basement_lock", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_crime_scene_fiber",
            "displayName": "Scene re-examination (Day 3)",
            "unlockConditions": [
                { "kind": 0, "a": "d3p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "receipt_known",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "carpet_shop_receipt", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "With Ernesto's debt arrangement in mind, I check the splinters on the lower corner of the wall." },
                        { "speaker": "", "text": "A synthetic olive-green fiber, exactly matching the roll from Ernesto Vidal's shop." },
                        { "speaker": "", "text": "Ernesto was forced to sweep and search the crime scene in the dark under Robert's orders, leaving traces of his work clothes." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" },
                        { "kind": 0, "a": "carpet_body_wrap_deduced", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "On the second pass, you notice what you missed the first night." },
                        { "speaker": "", "text": "An olive-green fiber snagged on a rough splinter. It's not from any motel linen." },
                        { "speaker": "", "text": "Synthetic carpet fabric. Only Ernesto's shop stocks this exact weave in town." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carpet_fiber", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_town_square_morning",
            "displayName": "Town square, last morning",
            "unlockConditions": [
                { "kind": 0, "a": "d3p1_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The town square is quieter than usual. Word's gotten around that the sheriff is coming tonight." },
                        { "speaker": "", "text": "A couple of shopkeepers watch me from their windows without pretending not to." },
                        { "speaker": "", "text": "Everyone already has an opinion about how this ends. None of them are willing to say it to my face." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_basement_revisit",
            "displayName": "Basement, second look",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "combo",
                    "priority": 1,
                    "conditions": [
                        { "kind": 3, "a": "basement_lock", "b": "", "negate": false },
                        { "kind": 3, "a": "basement_exclusive_access", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Padlock and latch busted outward from within. A single key in the entire complex, held exclusively by Robert Hale." },
                        { "speaker": "", "text": "Two physical facts that destroy any claim that Carla's death was a random highway robbery." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "basement_combo_confirmed", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "I take another look at the basement door. The pieces are coming together, but I need the full chain of evidence." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_robert_office",
            "displayName": "Robert's office",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "A meticulous maintenance log on Robert's desk. Precise entries: 'valve inspection,' 'boiler check,' 'generator upkeep.'" },
                        { "speaker": "", "text": "A calculated, immaculate record. The paper trail of a man who plans every excuse in advance." }
                    ],
                    "effects": [
                        { "kind": 0, "a": "maintenance_log_seen", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_near_basement_carla",
            "displayName": "Corner by the basement",
            "unlockConditions": [
                { "kind": 0, "a": "d3p2_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "elena_trusted",
                    "priority": 1,
                    "conditions": [
                        { "kind": 0, "a": "elena_trust_intact", "b": "", "negate": false }
                    ],
                    "lines": [
                        { "speaker": "", "text": "Following what Elena let slip in her terror, I search behind the stack of wooden toolboxes near the boiler room." },
                        { "speaker": "", "text": "Carla's leather travel bag. Inside is a single bus ticket to Seattle dated for that very dawn, and a thick envelope stuffed with $5,000 cash." },
                        { "speaker": "", "text": "Carla betrayed Elena by stealing the full escape fund. Robert took the bag after killing Carla and stashed it here to retrieve later." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" },
                        { "kind": 0, "a": "carla_escape_ticket_found", "b": "" }
                    ]
                },
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Behind some toolboxes near the boiler wall: a woman's travel bag hidden in the shadows." },
                        { "speaker": "", "text": "Carla's bag contains a single bus ticket to Seattle and $5,000 in cash. The escape money Elena spoke of." },
                        { "speaker": "", "text": "Whoever killed Carla took her bag from the bushes and hid it here, waiting for the police to leave." }
                    ],
                    "effects": [
                        { "kind": 3, "a": "carla_belongings", "b": "" }
                    ]
                }
            ]
        },
        {
            "id": "inv_case_review",
            "displayName": "Review the case file",
            "unlockConditions": [
                { "kind": 0, "a": "d3p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "I lay everything out on the bed in room 4: notes, names, half-formed theories crossed out twice." },
                        { "speaker": "", "text": "Every thread in this town leads back to the same motel, the same basement, the same padlock." },
                        { "speaker": "", "text": "By tonight I have to turn this into an accusation. No more time to be careful." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_motel_sign_final",
            "displayName": "The Starlight sign, one last look",
            "unlockConditions": [
                { "kind": 0, "a": "d3p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The neon sign flickers the same way it did the night my car broke down out here, half the letters dead, the rest buzzing like they mean it." },
                        { "speaker": "", "text": "Three days ago this was just a roadside motel with a vacancy. Now I know every name on that guest registry better than my own." },
                        { "speaker": "", "text": "Whatever I decide tonight, that sign will keep flickering long after I'm gone." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_elena_note_left",
            "displayName": "A note under the office door",
            "unlockConditions": [
                { "kind": 0, "a": "d3p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "Elena's shift ended hours ago, but a folded scrap of paper is wedged under the office door where only I'd find it." },
                        { "speaker": "", "text": "'If you don't nail him today, ask why nobody's seen me tomorrow. E.'" },
                        { "speaker": "", "text": "Not evidence. Just fear, in her handwriting, and I've run out of time to tell her it'll be enough." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_ernesto_shop_shutter",
            "displayName": "Carpet shop, shutter down",
            "unlockConditions": [
                { "kind": 0, "a": "d3p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The carpet shop's metal shutter is down hours earlier than usual, padlocked twice over." },
                        { "speaker": "", "text": "Through the gap at the bottom I can see boxes stacked by the door, ready to load, not to sell." },
                        { "speaker": "", "text": "Ernesto isn't hiding from the law tonight. He's hiding from somebody who scares him a lot more than I do." }
                    ],
                    "effects": []
                }
            ]
        },
        {
            "id": "inv_cafeteria_closed_marta",
            "displayName": "Cafeteria, closed for the night",
            "unlockConditions": [
                { "kind": 0, "a": "d3p3_started", "b": "", "negate": false }
            ],
            "variants": [
                {
                    "id": "default",
                    "priority": 0,
                    "conditions": [],
                    "lines": [
                        { "speaker": "", "text": "The cafeteria is dark, chairs stacked on tables, Marta's apron still hanging by the register." },
                        { "speaker": "", "text": "On the counter, under a coffee cup ring, someone's traced a name into the dust with one finger: ROBERT." },
                        { "speaker": "", "text": "She never says his name out loud. She didn't need to." }
                    ],
                    "effects": []
                }
            ]
        }
    ]
}
